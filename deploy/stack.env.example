# Stack configuration. Template for both stack env files: deploy/aws.env on the
# production host, deploy/rehearsal.env for a local rehearsal. Keep both off Git
# and chmod 600.
#
# These are Docker Compose interpolation inputs, not app environment. Compose
# assembles DATABASE_URL and INTERMEDIATE_DATABASE_URL from the passwords below,
# and DOMAIN / ACME_EMAIL / the admin password never reach the app at all.
#
# Full reference — defaults, what each variable is consumed by, and whether it
# reaches the app process: docs/configuration.md

# Point this domain's A/AAAA record at the host before starting Caddy.
DOMAIN=chat.example.com
ACME_EMAIL=ops@example.com

# Generate each independently: openssl rand -hex 32 (hex keeps them URL-safe).
# Read docs/configuration.md before changing one on a live stack.
APP_DB_PASSWORD=
INTERMEDIATE_ADMIN_PASSWORD=
INTERMEDIATE_READONLY_PASSWORD=

# Clerk production keys. The publishable key is also a Docker build arg.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Model provider. Leave MODEL_PROVIDER empty for OpenRouter, "mock" for an
# offline demonstration.
OPENROUTER_API_KEY=
MODEL_PROVIDER=
OPENROUTER_APP_TITLE=v7 Business Analyst

# Model alias overrides; empty falls back to the registry defaults.
MODEL_FAST=
MODEL_ANALYST=
MODEL_SQL=
MODEL_SUMMARIZER=
MODEL_FAST_REASONING=
MODEL_ANALYST_REASONING=
MODEL_SQL_REASONING=
MODEL_SUMMARIZER_REASONING=

# Agent SQL guardrails.
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ROWS=500

# Graceful shutdown. Keep the Compose stop grace period longer than this.
DRAIN_GRACE_MS=25000

# App semver shown in Langfuse Version/Metadata filters.
APP_VERSION=

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=production
LANGFUSE_RELEASE=
