# Template for both stack env files: deploy/aws.env on the production host, and
# deploy/rehearsal.env for a local rehearsal of the production stack. Keep both
# copies off Git.

# Point this domain's A/AAAA record at the EC2 instance before starting Caddy.
DOMAIN=chat.example.com
ACME_EMAIL=ops@example.com

# Use URL-safe values because Compose inserts these into PostgreSQL URLs.
# Generate each independently with: openssl rand -hex 32
APP_DB_PASSWORD=
INTERMEDIATE_ADMIN_PASSWORD=
INTERMEDIATE_READONLY_PASSWORD=

# Clerk production instance keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Model provider. Leave MODEL_PROVIDER empty for OpenRouter, or set it to mock
# only for an offline demonstration.
OPENROUTER_API_KEY=
MODEL_PROVIDER=
MODEL_FAST=
MODEL_ANALYST=
MODEL_SQL=
MODEL_SUMMARIZER=
MODEL_FAST_REASONING=
MODEL_ANALYST_REASONING=
MODEL_SQL_REASONING=
MODEL_SUMMARIZER_REASONING=
OPENROUTER_APP_TITLE=v7 Business Analyst
APP_VERSION=

# Agent SQL guardrails.
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ROWS=500

# Graceful shutdown. Keep the Compose stop grace period longer than this value.
DRAIN_GRACE_MS=25000

# Optional Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=production
LANGFUSE_RELEASE=
