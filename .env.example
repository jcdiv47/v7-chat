# ---------------------------------------------------------------------------
# Environment variables for the agentic business data analysis app (V1).
# Copy to .env.local and fill in. See docs/specs/01-system-architecture.md.
# ---------------------------------------------------------------------------

# --- Convex (frontend + CLI) ---
# Set automatically by `npx convex dev`. NEXT_PUBLIC_CONVEX_URL is read by the browser.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# The Convex *.convex.site HTTP action origin (where the chat stream endpoint lives).
# Usually the CONVEX cloud URL with `.convex.cloud` swapped for `.convex.site`.
# If unset, the client derives it from NEXT_PUBLIC_CONVEX_URL.
NEXT_PUBLIC_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# The following live in the *Convex deployment* environment (set with
# `npx convex env set NAME value`), because the agent loop and Postgres tools
# run inside Convex. The TUI and eval runner read the same names from the local
# environment.
# ---------------------------------------------------------------------------

# --- OpenRouter (first-class model provider) ---
OPENROUTER_API_KEY=
# Optional: overrides for the model registry aliases (raw OpenRouter model IDs).
MODEL_FAST=
MODEL_ANALYST=
MODEL_SQL=
MODEL_SUMMARIZER=
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=v7 Business Analyst

# Set to "mock" to run the agent loop against a deterministic offline model
# (no API key needed) for local UI / streaming / resumability testing.
MODEL_PROVIDER=

# --- Intermediate Postgres (read-only analytical database) ---
# Standard connection string, e.g. postgres://readonly:pw@host:5432/analytics
INTERMEDIATE_DATABASE_URL=
# Query guardrails (defaults applied if unset).
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ROWS=500

# If INTERMEDIATE_DATABASE_URL is unset, the TUI / eval runner fall back to an
# in-process pglite database seeded with sample cities/malls/stores data.
