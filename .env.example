# Host process configuration. Copy to .env.local and fill in.
#
# Read by `next dev` / `next build` (implicitly) and by the TUI, eval runner and
# seed script (explicitly). Never put production passwords here — those belong
# to the stack surface, deploy/stack.env.example.
#
# Full reference — defaults, which component reads each variable, and what is
# required: docs/configuration.md

# --- App Postgres: threads / messages / runs / stream chunks ---
# Dev: `docker compose up -d db`. Migrations apply automatically at boot.
DATABASE_URL=postgres://v7:v7@localhost:5433/v7_chat

# --- Clerk authentication (required; NEXT_PUBLIC_* is inlined at build time) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- OpenRouter (model provider) ---
OPENROUTER_API_KEY=
# Set to "mock" for the deterministic offline demo agent (no API key needed).
MODEL_PROVIDER=
# Attribution headers recommended by OpenRouter.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=v7 Business Analyst

# --- Model alias overrides (raw OpenRouter model IDs) ---
MODEL_FAST=
MODEL_ANALYST=
MODEL_SQL=
MODEL_SUMMARIZER=
# Per-alias reasoning effort (provider-default|none|minimal|low|medium|high|xhigh).
# MODEL_FAST_REASONING=
# MODEL_ANALYST_REASONING=
# MODEL_SQL_REASONING=
# MODEL_SUMMARIZER_REASONING=

# --- Intermediate Postgres: read-only analytical database ---
# Dev: `docker compose up -d intermediate-db` (port 5434), then
# `./scripts/import-intermediate-csv.sh --dev`. Unset, the TUI and eval runner
# fall back to an in-process pglite database seeded with sample data.
#   INTERMEDIATE_DATABASE_URL=postgres://v7_readonly:readonly@localhost:5434/analytics
INTERMEDIATE_DATABASE_URL=
# A writable admin connection for `npm run seed`.
SEED_DATABASE_URL=

# --- Agent SQL guardrails ---
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ROWS=500
# Caps serialized result bytes, and so persisted table artifacts.
SQL_MAX_RESULT_BYTES=700000

# --- Version and tracing (optional) ---
# App semver; see docs/configuration.md for the fallback chain.
APP_VERSION=
# Tracing is off unless both Langfuse keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_ENVIRONMENT=development
LANGFUSE_RELEASE=
