# ---------------------------------------------------------------------------
# Environment variables for the agentic business data analysis app (V1).
# Copy to .env.local and fill in. Everything runs in the one Next.js server
# process (Railway service variables in production). See docs/specs/01-system-architecture.md.
# ---------------------------------------------------------------------------

# --- App Postgres (threads / messages / runs / stream chunks) ---
# Dev: `docker compose up -d db` provides this database on port 5433.
# Prod: the Railway Postgres *private network* URL (postgres.railway.internal).
# Migrations are applied automatically at boot (and via `npm run db:migrate`).
DATABASE_URL=postgres://v7:v7@localhost:5433/v7_chat

# --- Clerk authentication (required) ---
# All pages require sign-in; data is scoped per Clerk user. Keys must also be
# present at build time (NEXT_PUBLIC_* is inlined into the client bundle).
# Keys: https://dashboard.clerk.com → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- OpenRouter (first-class model provider) ---
OPENROUTER_API_KEY=
# Optional: overrides for the model registry aliases (raw OpenRouter model IDs).
MODEL_FAST=
MODEL_ANALYST=
MODEL_SQL=
MODEL_SUMMARIZER=
# Optional: per-alias reasoning effort (minimal|low|medium|high|xhigh; sent as
# reasoning_effort to OpenRouter). Defaults: fast/summarizer=low, analyst/sql=medium.
# MODEL_FAST_REASONING=
# MODEL_ANALYST_REASONING=
# MODEL_SQL_REASONING=
# MODEL_SUMMARIZER_REASONING=
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=v7 Business Analyst

# Set to "mock" to run the agent loop against a deterministic offline model
# (no API key needed) for local UI / streaming / resumability testing.
MODEL_PROVIDER=

# --- Intermediate Postgres (read-only analytical database) ---
# Standard connection string, e.g. postgres://readonly:pw@host:5432/analytics
INTERMEDIATE_DATABASE_URL=
# Query guardrails (defaults applied if unset).
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_ROWS=500

# If INTERMEDIATE_DATABASE_URL is unset, the TUI / eval runner fall back to an
# in-process pglite database seeded with sample cities/malls/stores data.

# --- Production lifecycle (Railway) ---
# Let the app's SIGTERM drain (finish/finalize in-flight runs) own shutdown
# instead of Next.js exiting immediately. Recommended in production.
# NEXT_MANUAL_SIG_HANDLE=true
# Grace window for in-flight runs on deploy, before they are aborted.
# DRAIN_GRACE_MS=25000
