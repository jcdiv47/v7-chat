# Host process configuration: copy to .env.local; full reference: docs/configuration.md
# App database connection.
DATABASE_URL=postgres://v7:v7@localhost:5433/v7_chat
# Clerk browser credential.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk server credential.
CLERK_SECRET_KEY=
# Clerk sign-in route.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# Clerk sign-up route.
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Client-visible app version override.
NEXT_PUBLIC_APP_VERSION=
# OpenRouter credential.
OPENROUTER_API_KEY=
# Model provider selector.
MODEL_PROVIDER=
# OpenRouter attribution URL.
OPENROUTER_APP_URL=
# OpenRouter attribution title.
OPENROUTER_APP_TITLE=
# Fast model alias override.
MODEL_FAST=
# Analyst model alias override.
MODEL_ANALYST=
# SQL model alias override.
MODEL_SQL=
# Summarizer model alias override.
MODEL_SUMMARIZER=
# Fast model reasoning override.
MODEL_FAST_REASONING=
# Analyst model reasoning override.
MODEL_ANALYST_REASONING=
# SQL model reasoning override.
MODEL_SQL_REASONING=
# Summarizer model reasoning override.
MODEL_SUMMARIZER_REASONING=
# Read-only analytical database connection.
INTERMEDIATE_DATABASE_URL=
# Writable seed database connection.
SEED_DATABASE_URL=
# SQL timeout override.
SQL_STATEMENT_TIMEOUT_MS=
# SQL row-limit override.
SQL_MAX_ROWS=
# Persisted SQL result-size override.
SQL_MAX_RESULT_BYTES=
# Server-side app version override.
APP_VERSION=
# Langfuse public credential.
LANGFUSE_PUBLIC_KEY=
# Langfuse secret credential.
LANGFUSE_SECRET_KEY=
# Langfuse endpoint override.
LANGFUSE_BASE_URL=
# Langfuse environment label.
LANGFUSE_ENVIRONMENT=
# Langfuse release label.
LANGFUSE_RELEASE=
# Shutdown drain window override.
DRAIN_GRACE_MS=
